{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@designcodeio/threeui/style.css": ["./src/shaders/threeui.css"],
      "@designcodeio/threeui": ["./src/shaders/predictive-arc/PredictiveArcCollection.tsx"]
    }
  },
  "include": ["src"]
}
